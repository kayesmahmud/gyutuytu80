{
  "name": "@thulobazaar/auth-core",
  "version": "1.0.0",
  "description": "Shared OTP, phone-verification and SMS logic for Thulo Bazaar web and API (single source of truth)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@thulobazaar/database": "*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.3.0"
  }
}
